local function spawnChunk(chunk, cf, velocity, ctx, heavy)
	local primary
	if chunk:IsA("Model") then
		primary = chunk.PrimaryPart
		if not primary then chunk:Destroy() return end
		chunk:PivotTo(cf)
	else
		primary = chunk
		chunk.CFrame = cf
	end
	chunk.Parent = GoreFolder

	local spin = heavy and 5 or 12
	primary.AssemblyLinearVelocity = velocity
	primary.AssemblyAngularVelocity = Vector3.new(rng:NextNumber(-spin, spin), rng:NextNumber(-spin, spin), rng:NextNumber(-spin, spin))

	local em = primary:FindFirstChildOfClass("ParticleEmitter")
	if em then
		task.delay(2.2, function()
			if em.Parent then em.Enabled = false end
		end)
	end

	fleshActive += 1
	fadeAndDestroy(chunk, ctx.fadeAt, function()
		fleshActive = math.max(0, fleshActive - 1)
	end)
end

local function spawnFlesh(torso, ctx, big, organ)
	local origin = torso.Position

	task.spawn(function()
		if organ and #OrganTemplates > 0 and fleshActive < CONFIG.MaxFlesh then
			local organModel = OrganTemplates[rng:NextInteger(1, #OrganTemplates)]:Clone()
			local dir = Vector3.new(rng:NextNumber(-0.6, 0.6), 1, rng:NextNumber(-0.6, 0.6)).Unit
			local cf = CFrame.new(origin + Vector3.new(0, 1.5, 0)) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0)
			spawnChunk(organModel, cf, dir * rng:NextNumber(12, 20), ctx, true)
			task.wait()
		end

		local count = big and rng:NextInteger(CONFIG.MinChunks, CONFIG.MaxChunks) or 0
		for i = 1, count do
			if fleshActive >= CONFIG.MaxFlesh then break end
			local chunk = makeFleshChunk()
			local dir = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(0.4, 1.3), rng:NextNumber(-1, 1)).Unit
			local cf = CFrame.new(origin + dir * 1.2)
				* CFrame.Angles(rng:NextNumber(0, 6.28), rng:NextNumber(0, 6.28), rng:NextNumber(0, 6.28))
			spawnChunk(chunk, cf, dir * rng:NextNumber(14, 34), ctx, false)
			if i % 2 == 0 then task.wait() end
		end
	end)
end

