local function saveSettings()
	if not writefile then return end
	pcall(function()
		writefile(SETTINGS_FILE, HttpService:JSONEncode({ Switches = State, Chances = Chances }))
	end)
end

local function loadSettings()
	if not (isfile and readfile) then return end
	pcall(function()
		if not isfile(SETTINGS_FILE) then return end
		local data = HttpService:JSONDecode(readfile(SETTINGS_FILE))
		local switches = data.Switches or data
		for key in pairs(State) do
			if type(switches[key]) == "boolean" then State[key] = switches[key] end
		end
		if type(data.Chances) == "table" then
			for i = 1, #Chances do
				local v = tonumber(data.Chances[i])
				if v then Chances[i] = math.clamp(v, 0, 100) end
			end
		end
	end)
end

