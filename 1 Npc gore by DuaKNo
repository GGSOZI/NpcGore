local function prepTemplate(obj, targetSize)
	local ext
	if obj:IsA("Model") then
		ext = obj:GetExtentsSize()
	elseif obj:IsA("BasePart") then
		ext = obj.Size
	end
	if not ext then return nil end

	local biggest = math.max(ext.X, ext.Y, ext.Z)
	local scale = (biggest > 0) and (targetSize / biggest) or 1

	local primary
	if obj:IsA("Model") then
		pcall(function() obj:ScaleTo(obj:GetScale() * scale) end)
		primary = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
		if not primary then return nil end
		obj.PrimaryPart = primary
		for _, d in ipairs(obj:GetDescendants()) do
			if d:IsA("BasePart") then
				if d ~= primary then
					local w = Instance.new("WeldConstraint")
					w.Part0 = primary
					w.Part1 = d
					w.Parent = primary
				end
				setPhysical(d)
			end
		end
	else
		if obj:IsA("MeshPart") then obj.Size = obj.Size * scale end
		primary = obj
		setPhysical(primary)
	end

	addDecor(primary)
	return obj
end

