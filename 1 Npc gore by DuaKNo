local function prune(list)
	for i = #list, 1, -1 do
		if list[i].dead then table.remove(list, i) end
	end
end

local function loadAsset(id)
	local obj
	local ok = pcall(function()
		obj = game:GetObjects("rbxassetid://" .. id)[1]
	end)
	if ok and obj then return obj end

	ok = pcall(function()
		local wrapper = InsertService:LoadAsset(id)
		obj = wrapper:GetChildren()[1]
		if obj then obj.Parent = nil end
		wrapper:Destroy()
	end)
	if ok and obj then return obj end
	return nil
end

local function cleanTemplate(obj)
	if obj:IsA("LuaSourceContainer") then return nil end
	for _, d in ipairs(obj:GetDescendants()) do
		if d:IsA("LuaSourceContainer") then d:Destroy() end
	end
	if not obj:IsA("Model") and not obj:IsA("BasePart") then
		local m = Instance.new("Model")
		for _, c in ipairs(obj:GetChildren()) do c.Parent = m end
		obj:Destroy()
		obj = m
	end
	return obj
end

