local function onDeath(model, torso, big, organ, data)
	if not torso or not torso.Parent then return end
	if data.wound then
		data.wound.att:Destroy()
		data.wound = nil
	end
	local ctx = newContext(data.params, CONFIG.TotalLife)

	if State.Audio then playDeathSound(torso.Position) end
	if State.Blood and not State.NoDeath and inRange(torso.Position) then
		bleed(torso, big, ctx)
		if big then flash(torso) end
	end
	if State.Flesh and (big or organ) then spawnFlesh(torso, ctx, big, organ) end
end

local function track(hum)
	if tracked[hum] then return end
	local model = hum.Parent
	if not model or not model:IsA("Model") then return end
	if not CONFIG.IncludePlayers and Players:GetPlayerFromCharacter(model) then return end
	if hum.Health <= 0 then return end

	local data = { params = newParams(model), wound = nil, acc = 0, last = 0 }
	tracked[hum] = data

	local prev = hum.Health
	local lastBefore = hum.Health
	local log = {}

	hum.HealthChanged:Connect(function(h)
		local drop = prev - h
		if drop > 0 then lastBefore = prev end
		prev = h
		if drop <= 0 then return end

		local now = os.clock()
		table.insert(log, { now, drop })
		while #log > 0 and now - log[1][1] > 1 do table.remove(log, 1) end

		if h <= 0 or not State.Blood or State.DeathOnly then return end
		data.acc += drop
		if now - data.last < (State.ReduceBlood and CONFIG.ReduceCooldown or CONFIG.HitCooldown) then return end

		local torso = hum.Parent and getTorso(hum.Parent)
		if not torso then return end
		local frac = data.acc / math.max(1, hum.MaxHealth)
		data.acc = 0
		data.last = now
		hitBleed(data, torso, frac)
	end)

	hum.Died:Connect(function()
		local now = os.clock()
		local sum = 0
		for _, e in ipairs(log) do
			if now - e[1] <= CONFIG.BigHitWindow then sum += e[2] end
		end
		local big = sum >= hum.MaxHealth * CONFIG.BigHitPercent or sum >= CONFIG.BigHitFlat

		local m = hum.Parent
		if not m then return end
		local organ = lastBefore > hum.MaxHealth * CONFIG.OrganMinHealth
		onDeath(m, getTorso(m), big, organ, data)
	end)
end

