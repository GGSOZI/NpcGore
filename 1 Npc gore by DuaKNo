end

local function bleed(torso, big, ctx)
	local w = makeWound(torso, big)
	local jet, mist, att, localDir = w.jet, w.mist, w.att, w.dir

	activeBleeds += 1
	local sc = State.ReduceBlood and CONFIG.ReduceScale or math.clamp(1 - (activeBleeds - 1) / CONFIG.BleedLoad, 0.4, 1)

	local function woundWorld()
		return torso.CFrame:PointToWorldSpace(w.offset)
	end

	mist:Emit(math.ceil((big and 40 or 16) * sc))
	jet:Emit(math.ceil((big and 40 or 16) * sc))
	for _ = 1, math.ceil((big and 20 or 8) * sc) do
		local dir = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(0.2, 1.2), rng:NextNumber(-1, 1)).Unit
		spawnDroplet(woundWorld(), dir * rng:NextNumber(8, big and 28 or 18), ctx)
	end

	task.spawn(function()
		local start = os.clock()

		local pulses = big and 8 or 5
		for p = 1, pulses do
			if not torso.Parent then break end
			if State.Blood then
				local strength = 1 - (p - 1) / pulses
				local count = math.floor((big and 22 or 14) * strength * sc) + 3
				for k = 1, count do
					if not torso.Parent then break end
					local dirW = torso.CFrame:VectorToWorldSpace(localDir)
					local spread = Vector3.new(rng:NextNumber(-0.18, 0.18), rng:NextNumber(-0.12, 0.18), rng:NextNumber(-0.18, 0.18))
					local speed = rng:NextNumber(20, 34) * (0.55 + 0.45 * strength) * (big and 1.25 or 1)
					spawnDroplet(woundWorld(), (dirW + spread).Unit * speed, ctx)
					if k % 2 == 0 then
						jet:Emit(1)
						task.wait()
					end
				end
				mist:Emit(3)
			end
			task.wait(rng:NextNumber(0.28, 0.42))
		end

		while os.clock() - start < CONFIG.BleedTime and torso.Parent do
			if State.Blood then
				local progress = (os.clock() - start) / CONFIG.BleedTime
				local count = math.max(1, math.floor(2 * (1 - progress) * sc + 0.5))
				for _ = 1, count do
					local vel = Vector3.new(rng:NextNumber(-3, 3), rng:NextNumber(0, 4), rng:NextNumber(-3, 3))
					spawnDroplet(woundWorld() + Vector3.new(rng:NextNumber(-0.4, 0.4), 0, rng:NextNumber(-0.4, 0.4)), vel, ctx)
				end
				if rng:NextNumber() < 0.4 then mist:Emit(1) end
			end
			task.wait(0.09)
		end
		att:Destroy()
		activeBleeds -= 1
	end)
end

local function hitBleed(data, torso, frac)
	local chance = Chances[#Chances]
	for i, limit in ipairs(CONFIG.HitTiers) do
		if frac <= limit then
			chance = Chances[i]
			break
		end
	end
	if rng:NextNumber() * 100 > chance then return end
	local reduce = State.ReduceBlood
	if (not reduce and hitTokens < 1) or not inRange(torso.Position) then return end
	if not reduce then hitTokens -= 1 end

	local lv = frac < CONFIG.HitLowPercent and CONFIG.HitLevels.low or CONFIG.HitLevels.medium
	local w = data.wound
	if not w or not w.att.Parent then
		w = makeWound(torso, false)
		data.wound = w
	else
		aimWound(w)
	end

	local sc = reduce and CONFIG.ReduceScale or math.clamp(1 - #droplets / CONFIG.MaxDroplets, 0.25, 1)
	w.jet.Speed = NumberRange.new(lv.speed, lv.speed * 1.6)
	if lv.jet > 0 then w.jet:Emit(math.ceil(lv.jet * sc)) end
	w.mist:Emit(math.ceil(lv.mist * sc))

	local ctx = newContext(data.params, CONFIG.HitBloodLife)
	local pos = torso.CFrame:PointToWorldSpace(w.offset)
	local dirW = torso.CFrame:VectorToWorldSpace(w.dir)
	for _ = 1, math.ceil(lv.drops * sc) do
		local spread = Vector3.new(rng:NextNumber(-0.4, 0.4), rng:NextNumber(-0.2, 0.4), rng:NextNumber(-0.4, 0.4))
		spawnDroplet(pos, (dirW + spread).Unit * rng:NextNumber(lv.speed * 0.6, lv.speed * 1.4), ctx)
	end
end

