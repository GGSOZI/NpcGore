local pendingFade, fading, destroyQueue = {}, {}, {}
local drying = {}
local sizers = {}
local sizerOf = setmetatable({}, { __mode = "k" })

local function fadeAndDestroy(inst, fadeAt, onDone)
	pendingFade[#pendingFade + 1] = { inst = inst, fadeAt = fadeAt, onDone = onDone }
end

local function startFade(e)
	local inst = e.inst
	if not inst or not inst.Parent then
		if e.onDone then e.onDone() end
		return
	end
	local parts, orig = {}, {}
	local function add(d)
		if d:IsA("BasePart") then
			parts[#parts + 1] = d
			orig[#orig + 1] = d.Transparency
		elseif d:IsA("Trail") or d:IsA("ParticleEmitter") then
			d.Enabled = false
		end
	end
	add(inst)
	for _, d in ipairs(inst:GetDescendants()) do add(d) end
	fading[#fading + 1] = { inst = inst, parts = parts, orig = orig, start = os.clock(), onDone = e.onDone }
end

local function stepFades(t)
	for i = #fading, 1, -1 do
		local f = fading[i]
		local a = (t - f.start) / CONFIG.FadeTime
		local finished = a >= 1 or not f.inst.Parent
		if finished then
			if f.inst.Parent then
				for j = 1, #f.parts do f.parts[j].Transparency = 1 end
			end
			destroyQueue[#destroyQueue + 1] = f
			local last = #fading
			fading[i] = fading[last]
			fading[last] = nil
		else
			local k = a * a
			for j = 1, #f.parts do
				local o = f.orig[j]
				f.parts[j].Transparency = o + (1 - o) * k
			end
		end
	end
end

local function addDry(part, from, to, dur)
	drying[#drying + 1] = { part = part, from = from, to = to, born = os.clock(), dur = dur }
end

local function stepDrying(t)
	for i = #drying, 1, -1 do
		local e = drying[i]
		local part = e.part
		local remove = false
		if not part.Parent then
			remove = true
		else
			local a = (t - e.born) / e.dur
			if a >= 1 then
				part.Color = e.to
				remove = true
			else
				part.Color = e.from:Lerp(e.to, math.sin(a * math.pi / 2))
			end
		end
		if remove then
			local last = #drying
			drying[i] = drying[last]
			drying[last] = nil
		end
	end
end

local function addSizer(part, from, to, dur, kind, owner)
	local e = { part = part, from = from, to = to, start = os.clock(), dur = dur, kind = kind, owner = owner }
	sizers[#sizers + 1] = e
	sizerOf[part] = e
end

local function stepSizers(t)
	for i = #sizers, 1, -1 do
		local e = sizers[i]
		local part = e.part
		local remove = false
		if not part.Parent then
			remove = true
		else
			local to = e.owner and e.owner.d or e.to
			local a = (t - e.start) / e.dur
			local y
			if a >= 1 then
				y = to
				remove = true
			elseif e.kind == "back" then
				local c1 = 1.70158
				local c3 = c1 + 1
				local x = a - 1
				y = e.from + (to - e.from) * (1 + c3 * x * x * x + c1 * x * x)
			else
				y = e.from + (to - e.from) * math.sin(a * math.pi / 2)
			end
			part.Size = Vector3.new(0.04, y, y)
		end
		if remove then
			sizerOf[part] = nil
			local last = #sizers
			sizers[i] = sizers[last]
			sizers[last] = nil
		end
	end
end

local function growPuddle(e)
	local ex = sizerOf[e.main]
	local now = os.clock()
	if ex then
		if ex.kind == "sine" and now - ex.start > 0.1 then
			ex.from = e.main.Size.Y
			ex.start = now
			ex.dur = 0.4
		end
		return
	end
	addSizer(e.main, e.main.Size.Y, e.d, 0.4, "sine", e)
end

local function stepPending(t)
	local started = 0
	for i = #pendingFade, 1, -1 do
		local e = pendingFade[i]
		if t >= e.fadeAt and started < 8 then
			started += 1
			startFade(e)
			local last = #pendingFade
			pendingFade[i] = pendingFade[last]
			pendingFade[last] = nil
		end
	end
end

local function stepDestroy()
	for _ = 1, 3 do
		local f = table.remove(destroyQueue)
		if not f then break end
		if f.inst then f.inst:Destroy() end
		if f.onDone then f.onDone() end
	end
end

local function makeSplashEmitter(parent)
	local att = Instance.new("Attachment")
	att.Parent = parent
	local em = Instance.new("ParticleEmitter")
	em.Texture = SMOKE_TEX
	em.Enabled = false
	em.Color = ColorSequence.new(BLOOD)
	em.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.22), NumberSequenceKeypoint.new(1, 0) })
	em.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	em.Lifetime = NumberRange.new(0.25, 0.5)
	em.Speed = NumberRange.new(4, 10)
	em.SpreadAngle = Vector2.new(45, 45)
	em.Acceleration = Vector3.new(0, -45, 0)
	em.LightInfluence = 1
	em.Parent = att
	return em
end

local function makePuddle(position, ctx)
	for i = 1, #puddles do
		local e = puddles[i]
		if not e.dead then
			local dx, dz = e.pos.X - position.X, e.pos.Z - position.Z
			local r = e.d * 0.45
			if dx * dx + dz * dz < r * r and math.abs(e.pos.Y - position.Y) < 1.5 then
				if e.d < 4.5 then
					e.d += 0.18
					growPuddle(e)
				end
				return
			end
		end
	end

	if puddleBudget <= 0 then return end
	puddleBudget -= 1

	prune(puddles)
	if #puddles >= CONFIG.MaxPuddles then
		local old = table.remove(puddles, 1)
		if old then
			old.dead = true
			old.inst:Destroy()
		end
	end

	local folder = Instance.new("Folder")
	folder.Name = "BloodPuddle"
	folder.Parent = GoreFolder

	local base = rng:NextNumber(1.0, 2.2)
	local entry = { inst = folder, pos = position, d = base, dead = false }
	local blobs = rng:NextInteger(3, 6)

	for i = 1, blobs do
		local d = (i == 1) and base or base * rng:NextNumber(0.35, 0.7)
		local off = (i == 1) and Vector3.zero
			or Vector3.new(rng:NextNumber(-0.5, 0.5) * base, 0, rng:NextNumber(-0.5, 0.5) * base)

		local pud = Instance.new("Part")
		pud.Name = "Blob"
		pud.Shape = Enum.PartType.Cylinder
		pud.Anchored = true
		pud.CanCollide = false
		pud.CanQuery = false
		pud.CanTouch = false
		pud.CastShadow = false
		pud.Material = Enum.Material.SmoothPlastic
		pud.Reflectance = 0
		local fresh = BLOOD:Lerp(BLOOD_DARK, rng:NextNumber(0, 0.3))
		pud.Color = fresh
		pud.Size = Vector3.new(0.04, 0.2, 0.2)
		pud.CFrame = CFrame.new(position + off + Vector3.new(0, 0.025 + i * 0.004, 0))
			* CFrame.Angles(0, rng:NextNumber(0, 6.28), math.rad(90))
		pud.Parent = folder

		addDry(pud, fresh, BLOOD_DARK:Lerp(Color3.new(0, 0, 0), rng:NextNumber(0.1, 0.35)), 9)

		if i == 1 then
			entry.main = pud
			addSizer(pud, 0.2, d, rng:NextNumber(0.6, 1.0), "back", entry)
			local em = makeSplashEmitter(pud)
			em:Emit(6)
		else
			addSizer(pud, 0.2, d, rng:NextNumber(0.6, 1.0), "back", nil)
		end
	end

	for _ = 1, rng:NextInteger(3, 7) do
		local ang = rng:NextNumber(0, 6.28)
		local dist = base * rng:NextNumber(0.55, 1.1)
		local sd = rng:NextNumber(0.08, 0.28)
		local sat = Instance.new("Part")
		sat.Shape = Enum.PartType.Cylinder
		sat.Anchored = true
		sat.CanCollide = false
		sat.CanQuery = false
		sat.CanTouch = false
		sat.CastShadow = false
		sat.Material = Enum.Material.SmoothPlastic
		sat.Reflectance = 0
		sat.Color = BLOOD
		sat.Size = Vector3.new(0.03, sd, sd)
		sat.CFrame = CFrame.new(position + Vector3.new(math.cos(ang) * dist, 0.03, math.sin(ang) * dist))
			* CFrame.Angles(0, 0, math.rad(90))
		sat.Parent = folder
		addDry(sat, BLOOD, BLOOD_DARK, 9)
	end

	table.insert(puddles, entry)
	fadeAndDestroy(folder, ctx.fadeAt, function() entry.dead = true end)
end

local function makeWallSplat(hit, ctx)
	if splatBudget <= 0 then return end
	splatBudget -= 1

	prune(splats)
	if #splats >= CONFIG.MaxSplats then
		local old = table.remove(splats, 1)
		if old then
			old.dead = true
			old.inst:Destroy()
		end
	end

	local n = hit.Normal
	local pos = hit.Position + n * 0.02
	local w = rng:NextNumber(0.3, 0.8)
	local facing = CFrame.lookAt(pos, pos + n)

	local folder = Instance.new("Folder")
	folder.Name = "BloodSplat"
	folder.Parent = GoreFolder

	local function basePart(shape)
		local p = Instance.new("Part")
		p.Shape = shape
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Material = Enum.Material.SmoothPlastic
		p.Color = BLOOD:Lerp(BLOOD_DARK, rng:NextNumber(0, 0.3))
		p.Reflectance = 0
		p.Parent = folder
		return p
	end

	local splat = basePart(Enum.PartType.Cylinder)
	splat.Size = Vector3.new(0.03, 0.1, 0.1)
	splat.CFrame = facing * CFrame.Angles(0, math.rad(90), 0)
	TweenService:Create(splat, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = Vector3.new(0.03, w, w) }):Play()

	local drip = rng:NextNumber(0.8, 2.2)
	local streak = basePart(Enum.PartType.Block)
	streak.Size = Vector3.new(w * 0.2, 0.1, 0.03)
	streak.CFrame = facing
	TweenService:Create(streak, TweenInfo.new(rng:NextNumber(1.4, 2.4), Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
		Size = Vector3.new(w * 0.2, drip, 0.03),
		CFrame = facing + Vector3.new(0, -drip / 2, 0),
	}):Play()

	for _ = 1, rng:NextInteger(3, 5) do
		local off = facing.RightVector * rng:NextNumber(-1, 1) * w * 1.3
			+ facing.UpVector * rng:NextNumber(-1, 1) * w * 1.3
		local sd = rng:NextNumber(0.06, 0.2)
		local dot = basePart(Enum.PartType.Cylinder)
		dot.Size = Vector3.new(0.03, sd, sd)
		dot.CFrame = CFrame.lookAt(pos + off, pos + off + n) * CFrame.Angles(0, math.rad(90), 0)
	end

	for _, part in ipairs(folder:GetChildren()) do
		local fresh = BLOOD:Lerp(BLOOD_DARK, rng:NextNumber(0, 0.3))
		part.Color = fresh
		addDry(part, fresh, BLOOD_DARK, 8)
	end

	local entry = { inst = folder, dead = false }
	table.insert(splats, entry)
	fadeAndDestroy(folder, ctx.fadeAt, function() entry.dead = true end)
end

local dropFree = {}
local dropCreated = 0

local function createDropObj()
	local p = Instance.new("Part")
	p.Name = "BloodDrop"
	p.Size = Vector3.new(0.1, 0.1, 0.1)
	p.Transparency = 1
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.CFrame = PARK

	local a0 = Instance.new("Attachment")
	a0.Parent = p
	local a1 = Instance.new("Attachment")
	a1.Parent = p

	local tr = Instance.new("Trail")
	tr.Attachment0 = a0
	tr.Attachment1 = a1
	tr.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.7, 0.15),
		NumberSequenceKeypoint.new(1, 1),
	})
	tr.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.15) })
	tr.MinLength = 0.02
	tr.FaceCamera = true
	tr.LightEmission = 0
	tr.LightInfluence = 1
	tr.Enabled = false
	tr.Parent = p

	p.Parent = GoreFolder
	return { part = p, a0 = a0, a1 = a1, trail = tr }
end

task.spawn(function()
	for i = 1, CONFIG.MaxDroplets do
		if dropCreated >= CONFIG.MaxDroplets then break end
		dropCreated += 1
		dropFree[#dropFree + 1] = createDropObj()
		if i % 8 == 0 then task.wait() end
	end
end)

local function acquireDrop()
	local obj = table.remove(dropFree)
	if obj then return obj end
	if dropCreated >= CONFIG.MaxDroplets then return nil end
	dropCreated += 1
	return createDropObj()
end

local function releaseDrop(obj)
	obj.trail.Enabled = false
	obj.part.CFrame = PARK
	dropFree[#dropFree + 1] = obj
end

local function spawnDroplet(pos, vel, ctx)
	local obj = acquireDrop()
	if not obj then return end

	local len = rng:NextNumber(0.16, 0.36)
	obj.a0.Position = Vector3.new(0, len / 2, 0)
	obj.a1.Position = Vector3.new(0, -len / 2, 0)

	local tr = obj.trail
	tr.Color = ColorSequence.new(BLOOD, BLOOD_DARK:Lerp(BLOOD, rng:NextNumber(0, 0.5)))
	tr.Lifetime = rng:NextNumber(0.2, 0.34)

	obj.part.CFrame = CFrame.new(pos)
	tr:Clear()
	tr.Enabled = true

	droplets[#droplets + 1] = { obj = obj, pos = pos, vel = vel, ctx = ctx, t = 0 }
end

local movParts, movCFs = {}, {}
local fadeAcc, dryAcc = 0, 0

RunService.Heartbeat:Connect(function(dt)
	local t = os.clock()
	puddleBudget = CONFIG.PuddlesPerFrame
	splatBudget = CONFIG.SplatsPerFrame
	hitTokens = math.min(CONFIG.MaxHitBurstsPerSecond, hitTokens + dt * CONFIG.MaxHitBurstsPerSecond)

	local g = Vector3.new(0, -workspace.Gravity * 0.6, 0)
	local n = 0
	for i = #droplets, 1, -1 do
		local d = droplets[i]
		d.t += dt
		local pos = d.pos
		local vel = d.vel + g * dt
		local step = vel * dt
		local hit = workspace:Raycast(pos, step, d.ctx.params)
		local done = false

		if hit then
			local hitModel = hit.Instance:FindFirstAncestorOfClass("Model")
			local onBody = hitModel and hitModel:FindFirstChildOfClass("Humanoid")
			if not onBody then
				if hit.Normal.Y > 0.5 then
					makePuddle(hit.Position, d.ctx)
				elseif math.abs(hit.Normal.Y) < 0.6 and rng:NextNumber() < 0.5 then
					makeWallSplat(hit, d.ctx)
				end
			end
			done = true
		elseif d.t > 6 then
			done = true
		else
			local np = pos + step
			d.pos = np
			d.vel = vel
			n += 1
			movParts[n] = d.obj.part
			movCFs[n] = CFrame.new(np)
		end

		if done then
			releaseDrop(d.obj)
			local last = #droplets
			droplets[i] = droplets[last]
			droplets[last] = nil
		end
	end
	if n > 0 then
		workspace:BulkMoveTo(movParts, movCFs, Enum.BulkMoveMode.FireCFrameChanged)
		table.clear(movParts)
		table.clear(movCFs)
	end

	stepPending(t)
	stepSizers(t)

	fadeAcc += dt
	if fadeAcc >= 0.05 then
		fadeAcc = 0
		stepFades(t)
	end
	dryAcc += dt
	if dryAcc >= 0.2 then
		dryAcc = 0
		stepDrying(t)
	end
	stepDestroy()
end)

local function newParams(model)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { GoreFolder, model }
	params.RespectCanCollide = true
	return params
end

local function newContext(params, life)
	return { fadeAt = os.clock() + life, params = params }
end

local function inRange(pos)
	local cam = workspace.CurrentCamera
	return not cam or (cam.CFrame.Position - pos).Magnitude <= CONFIG.MaxDistance
end

local function aimWound(w)
	w.offset = Vector3.new(rng:NextNumber(-0.7, 0.7), rng:NextNumber(-0.3, 0.6), rng:NextNumber(-0.5, 0.5))
	w.dir = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(0.5, 1.2), rng:NextNumber(-1, 1)).Unit
	w.att.CFrame = CFrame.lookAt(w.offset, w.offset + w.dir)
end

local function makeWound(torso, big)
	local att = Instance.new("Attachment")
	att.Name = "WoundAttachment"
	local w = { att = att }
	aimWound(w)
	att.Parent = torso

	local jet = Instance.new("ParticleEmitter")
	jet.Texture = SMOKE_TEX
	jet.Enabled = false
	jet.Color = ColorSequence.new(BLOOD, BLOOD_DARK)
	jet.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0.08) })
	jet.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(0.6, 0.3),
		NumberSequenceKeypoint.new(1, 1),
	})
	jet.Lifetime = NumberRange.new(0.35, 0.7)
	jet.Speed = NumberRange.new(big and 30 or 22, big and 48 or 36)
	jet.SpreadAngle = Vector2.new(14, 14)
	jet.EmissionDirection = Enum.NormalId.Front
	jet.LightInfluence = 1
	jet.Rotation = NumberRange.new(0, 360)
	jet.Acceleration = Vector3.new(0, -75, 0)
	jet.Parent = att

